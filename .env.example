# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.

# Облачная модель (DeepSeek, OpenAI-совместимый API)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# У deepseek-flash по умолчанию включён режим рассуждений, для этой задачи он не нужен
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# Локальная модель через Ollama: ключ не нужен, тот же код
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=
# LLM_EXTRA_BODY=

# Необязательные настройки
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=3
