# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.

# Облачная модель: Gemini через OpenAI-совместимый API
# Ключ: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Локальная модель через Ollama: ключ не нужен, тот же код
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=

# Необязательные настройки
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=3
# LLM_EXTRA_BODY={"reasoning_effort": "none"}
