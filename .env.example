# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.

# Облачная модель: Gemini через OpenRouter (OpenAI-совместимый API)
# Ключ: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.5-flash-lite
LLM_API_KEY=

# Локальная модель через Ollama: ключ не нужен, тот же код
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=

# Необязательные настройки
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=3
# LLM_EXTRA_BODY={"reasoning_effort": "none"}
