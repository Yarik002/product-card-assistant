# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.

# Облачная модель через OpenRouter (OpenAI-совместимый API).
# Ключ: https://openrouter.ai/keys. У этой модели есть бесплатный лимит запросов в день.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_API_KEY=
# Без этого параметра у модели весь лимит токенов уходит на рассуждения и ответ пустой
LLM_EXTRA_BODY={"reasoning": {"enabled": false}}

# Локальная модель через Ollama: ключ не нужен, тот же код.
# Закомментируйте строки выше и раскомментируйте эти:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=
# LLM_EXTRA_BODY=

# Необязательные настройки
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=3
